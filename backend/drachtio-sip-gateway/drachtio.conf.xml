<?xml version="1.0"?>
<!--
  drachtio-server config for the telephony gateway.

  Notes:
  - admin socket on 0.0.0.0:9022 is fine because the task security group
    denies ingress to 9022 (only 5060/tcp and 16000-16048/udp are allowed
    from the Network Load Balancer (NLB) security group). The shared
    secret is required regardless.
  - sip contact binds TCP 5060 on all interfaces of the task ENI.
  - cdrs=true emits one JSON Call Detail Record (CDR) per call to stdout,
    which lands in CloudWatch Logs.
  - sofia-loglevel and loglevel are info; crank up to 7/debug when triaging
    call failures from inside the container.
-->
<drachtio>
  <admin port="9022" secret="${DRACHTIO_SECRET}">0.0.0.0</admin>
  <sip>
    <contacts>
      <contact>sip:*:5060;transport=tcp</contact>
    </contacts>
  </sip>
  <cdrs>true</cdrs>
  <logging>
    <console/>
    <sofia-loglevel>3</sofia-loglevel>
    <loglevel>info</loglevel>
  </logging>
</drachtio>
